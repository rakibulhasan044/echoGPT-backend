model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  fullName        String?
  role            Role      @default(USER)
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

enum Role {
    ADMIN
    USER
}
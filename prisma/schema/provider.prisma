model Provider {
  id        String   @id @default(uuid())
  name      String   @unique
  baseUrl   String?
  apiKey    String // Encrypted AES-256
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("providers")
}
